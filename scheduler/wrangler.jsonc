{
  "$schema": "../node_modules/wrangler/config-schema.json",
  "name": "karhutla-watch-scheduler",
  "account_id": "7cba2fd7ef4fdc0437a87ad443c6401b",
  "main": "worker.ts",
  "compatibility_date": "2026-10-12",
  "workers_dev": false,
  "preview_urls": false,
  "triggers": { "crons": ["17,47 * * * *"] },
  "vars": {
    "GITHUB_REPOSITORY": "ramaikn/karhutla-watch",
    "GITHUB_WORKFLOW": "refresh-data.yml",
    "GITHUB_REF": "main"
  },
  "observability": { "enabled": true }
}
